# Copy to up-dp/.env. Every variable can also be read from a file named by
# <NAME>_FILE, which is how mounted secrets reach the container.

ADDR=:8080
ENV=Development
SPA_DIR=up-dp/web/dist

# The one org this portal serves. Users never type the handle; the header shows it.
ORG_UUID=8f7c2a0e-4d1b-4c6a-9b3e-2f5d7a1c9e40
ORG_HANDLE=acme
ORG_NAME=Acme Corporation

# The environment this portal is published from: its UUID. Every iPaaS-Service
# call names it. The mock's environments are production (this one) and development.
ENVIRONMENT_ID=d4409876-6a7a-56bc-a3c6-ced5a83c922b

# What the SPA shows.
PORTAL_NAME=User Portal
PRODUCT_NAME=Integration Platform
# An Oxygen UI theme key; see up-dp/web/README.md for the list.
PORTAL_THEME=choreoLabs
# Optional. Overrides the theme's primary colour, e.g. #2f5fa7 for the old portal's blue.
# PORTAL_PRIMARY_COLOR=
# PORTAL_TERMS_URL=https://wso2.com/terms-of-use/
# PORTAL_PRIVACY_URL=https://wso2.com/privacy-policy/
# PORTAL_SUPPORT_URL=
# Optional. The header's logo on a light and on a dark background: an absolute URL or a path
# UP-DP serves. One set alone is used for both; with neither, the WSO2 Integration Platform wordmark.
# PORTAL_LOGO_LIGHT_URL=
# PORTAL_LOGO_DARK_URL=

# The portal app on the published environment's WIdP-DP (ThunderID): a public
# client (token endpoint auth method "none", PKCE required) the SPA signs in with.
# UP-DP hands the issuer and client to the SPA in /config.js, and verifies the access
# tokens itself against the signing keys the issuer's discovery document names.
OIDC_ISSUER=https://localhost:8090
OIDC_CLIENT_ID=
# The portal's API resource on that ThunderID: the SPA asks for tokens for it
# (RFC 8707 resource), and UP-DP checks it as their audience.
OIDC_RESOURCE=
# The SPA requests these, offline_access, the portal's own scopes (aiagent:view,
# automation:view, automation:trigger, workflow:view) and the scopes of the
# integrations published in ENVIRONMENT_ID, all from /api/v1/auth/scopes.
OIDC_SCOPES=openid profile email roles
# Local only: a local ThunderID's certificate is self-signed.
# OIDC_INSECURE_TLS=true

# iPaaS-Service's portal routes, called with the org's Platform IdP portal client.
IPAAS_BASE_URL=http://localhost:9090/user-portal
IPAAS_TOKEN_URL=http://localhost:9100/oauth2/token
IPAAS_CLIENT_ID=wc-user-portal-8f7c2a0e-4d1b-4c6a-9b3e-2f5d7a1c9e40
IPAAS_CLIENT_SECRET=portal-client-secret

# CATALOG_CACHE_TTL=30s
# CATALOG_STALE_TTL=15m
# SCOPES_CACHE_TTL=10m
