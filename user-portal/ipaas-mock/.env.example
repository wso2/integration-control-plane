# Copy to ipaas-mock/.env. Every value below is the default.

MOCK_ORG_UUID=8f7c2a0e-4d1b-4c6a-9b3e-2f5d7a1c9e40
MOCK_ORG_HANDLE=acme
MOCK_ORG_NAME=Acme Corporation

# Platform IdP: the client-credentials token endpoint.
MOCK_IDP_ADDR=:9100
MOCK_IDP_ISSUER=http://localhost:9100
MOCK_PORTAL_CLIENT_ID=wc-user-portal-8f7c2a0e-4d1b-4c6a-9b3e-2f5d7a1c9e40
MOCK_PORTAL_CLIENT_SECRET=portal-client-secret

# iPaaS-Service portal routes.
MOCK_IPAAS_ADDR=:9090
MOCK_RUN_DURATION=8s

# API gateway: UP-DP, agents and workflows.
MOCK_GATEWAY_ADDR=:9200
GATEWAY_URL=http://localhost:9200
# CORS for the agent and workflow routes.
GATEWAY_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# UP-DP, which the gateway fronts at every path that is not an agent's or a workflow's.
UP_DP_UPSTREAM=http://localhost:8080
# Set to the WIdP-DP's JWKS URL to verify the bearer tokens of agent and workflow calls.
# Without it they are only read. UP-DP verifies its own.
# GATEWAY_JWKS_URL=https://localhost:8090/oauth2/jwks
# GATEWAY_ISSUER=https://localhost:8090
# GATEWAY_INSECURE_TLS=true
MOCK_STEP_DURATION=4s
