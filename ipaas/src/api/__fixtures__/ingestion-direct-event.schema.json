{
  "$comment": "Copied from wso2-enterprise/integration-context-engine contracts/schemas/ingestion-direct-event.schema.json at 43ca6f5; only this $comment is added.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.invalid/schemas/ingestion-direct-event-v1.json",
  "title": "Context ingestion event delivered with its content",
  "description": "The event part of a one-call delivery. The engine stages the content part and supplies the content reference and hash, so an upsert carries neither; contentType and contentHash, when present, must match the content part.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "sourceRecordId", "sourceVersion", "operation", "sourceObservedAt", "audience", "idempotencyKey"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceRecordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation": {
      "enum": ["upsert", "delete"]
    },
    "contentType": {
      "type": "string",
      "maxLength": 200
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceObservedAt": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    }
  }
}
