# Build artifacts and caches we'll regenerate inside the image
node_modules
dist
.vite
.cache
.turbo
coverage
stats.html
**/coverage
**/stats.html

# VCS
.git
.gitignore

# Editor/IDE
.idea
.vscode
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

