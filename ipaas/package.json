{
  "private": true,
  "name": "@wso2/oxygen-ui-test-app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "PRODUCT=wip vite",
    "dev:cloud": "PRODUCT=cloud vite",
    "dev:icp": "PRODUCT=icp vite",
    "build": "PRODUCT=wip vite build",
    "build:cloud": "PRODUCT=cloud vite build",
    "build:icp": "PRODUCT=icp vite build",
    "build:check": "tsc -b && PRODUCT=wip vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:get-gmail-token": "dotenv -e .env.test -- tsx tests/e2e/get-gmail-token.ts",
    "test:e2e:save-google-auth": "dotenv -e .env.test -- playwright test --project=save-google-session"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.20",
    "@wso2/cell-diagram": "0.2.0",
    "@wso2/oxygen-ui": "^0.8.0",
    "@wso2/oxygen-ui-charts-react": "^0.8.0",
    "@wso2/oxygen-ui-icons-react": "^0.9.1",
    "graphql": "^16.14.2",
    "mermaid": "^11.14.0",
    "moesif-browser-js": "1.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "7.9.4",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swagger-ui-react": "^5.32.1",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "lucide-react@0.545.0": "patches/lucide-react@0.545.0.patch",
      "@wso2/cell-diagram@0.2.0": "patches/@wso2__cell-diagram@0.2.0.patch",
      "@wso2/oxygen-ui@0.8.0": "patches/@wso2__oxygen-ui@0.8.0.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "@vitejs/plugin-react-swc": "4.2.0",
    "@vitest/ui": "^4.1.9",
    "dotenv-cli": "^8.0.0",
    "eslint": "9.12.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "googleapis": "^173.0.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "6.0.5",
    "sass": "^1.99.0",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.1.12",
    "vitest": "^4.1.9"
  }
}
