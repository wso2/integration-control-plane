{
    "index_patterns": [
        "ballerina-application-logs-*",
        "ballerina-metrics-logs-*",
        "mi-application-logs-*",
        "mi-metrics-logs-*"
    ],
    "template": {
        "mappings": {
            "properties": {
                "kubernetes": {
                    "type": "object",
                    "properties": {
                        "labels": {
                            "type": "object",
                            "properties": {
                                "app": {
                                    "type": "keyword"
                                },
                                "component": {
                                    "type": "keyword"
                                }
                            }
                        }
                    }
                },
                "time": {
                    "type": "date"
                },
                "message": {
                    "type": "text"
                },
                "level": {
                    "type": "keyword"
                },
                "icp_runtimeId": {
                    "type": "keyword"
                },
                "integration": {
                    "type": "keyword"
                },
                "product": {
                    "type": "keyword"
                },
                "component": {
                    "type": "keyword"
                },
                "package": {
                    "type": "keyword"
                },
                "log_type": {
                    "type": "keyword"
                },
                "service_type": {
                    "type": "keyword"
                },
                "app": {
                    "type": "keyword"
                },
                "app_name": {
                    "type": "keyword"
                },
                "deployment": {
                    "type": "keyword"
                },
                "module": {
                    "type": "keyword"
                },
                "class": {
                    "type": "keyword"
                },
                "artifact_container": {
                    "type": "keyword"
                },
                "status": {
                    "type": "keyword"
                },
                "sublevel": {
                    "type": "keyword"
                },
                "src_client_remote": {
                    "type": "keyword"
                },
                "url": {
                    "type": "keyword"
                },
                "app_module": {
                    "type": "keyword"
                },
                "src_module": {
                    "type": "keyword"
                },
                "protocol": {
                    "type": "keyword"
                },
                "method": {
                    "type": "keyword"
                },
                "http_method": {
                    "type": "keyword"
                },
                "status_code_group": {
                    "type": "keyword"
                },
                "http_status_code_group": {
                    "type": "keyword"
                },
                "src_object_name": {
                    "type": "keyword"
                },
                "src_function_name": {
                    "type": "keyword"
                },
                "entrypoint_function_name": {
                    "type": "keyword"
                },
                "entrypoint_function_module": {
                    "type": "keyword"
                },
                "response_time_seconds": {
                    "type": "float"
                },
                "response_time": {
                    "type": "long"
                }
            }
        }
    }
}
